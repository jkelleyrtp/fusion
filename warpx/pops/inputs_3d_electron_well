ibeam.intervals = 20
cbeam.type = BeamRelevant
cbeam.species = cold
cbeam.intervals = 20
sbeam.type = BeamRelevant
sbeam.species = seed
sbeam.intervals = 20
# particles per radial shell, to see how much electron charge sits inside the ion cloud
irad.type = ParticleHistogram
irad.species = ions
irad.intervals = hist_every
irad.histogram_function(t,x,y,z,ux,uy,uz) = "sqrt(x*x+y*y+z*z)"
irad.bin_number = 40
irad.bin_min = 0.
irad.bin_max = a
erad.type = ParticleHistogram
erad.species = electrons
erad.intervals = hist_every
erad.histogram_function(t,x,y,z,ux,uy,uz) = "sqrt(x*x+y*y+z*z)"
erad.bin_number = 40
erad.bin_min = 0.
erad.bin_max = a
krad.type = ParticleHistogram
krad.species = core
krad.intervals = hist_every
krad.histogram_function(t,x,y,z,ux,uy,uz) = "sqrt(x*x+y*y+z*z)"
krad.bin_number = 40
krad.bin_min = 0.
krad.bin_max = a
crad.type = ParticleHistogram
crad.species = cold
crad.intervals = hist_every
crad.histogram_function(t,x,y,z,ux,uy,uz) = "sqrt(x*x+y*y+z*z)"
crad.bin_number = 40
crad.bin_min = 0.
crad.bin_max = a
srad.type = ParticleHistogram
srad.species = seed
srad.intervals = hist_every
srad.histogram_function(t,x,y,z,ux,uy,uz) = "sqrt(x*x+y*y+z*z)"
srad.bin_number = 40
srad.bin_min = 0.
srad.bin_max = a
# kinetic energy (eV) of the slow-beam electrons inside 1 mm
cke.type = ParticleHistogram
cke.species = cold
cke.intervals = hist_every
cke.histogram_function(t,x,y,z,ux,uy,uz) = "0.5*m_e*clight**2/q_e*(ux*ux+uy*uy+uz*uz)"
cke.filter_function(t,x,y,z,ux,uy,uz) = "x*x+y*y+z*z<1.0e-6"
cke.bin_number = 80
cke.bin_min = 0.
cke.bin_max = 8000.

lrad.type = ParticleHistogram
lrad.species = late
lrad.intervals = hist_every
lrad.histogram_function(t,x,y,z,ux,uy,uz) = "sqrt(x*x+y*y+z*z)"
lrad.bin_number = 40
lrad.bin_min = 0.
lrad.bin_max = a

lke.type = ParticleHistogram
lke.species = late
lke.intervals = hist_every
lke.histogram_function(t,x,y,z,ux,uy,uz) = "0.5*m_e*clight**2/q_e*(ux*ux+uy*uy+uz*uz)"
lke.filter_function(t,x,y,z,ux,uy,uz) = "x*x+y*y+z*z<1.0e-6"
lke.bin_number = 80
lke.bin_min = 0.
lke.bin_max = 8000.
number.type = ParticleNumber
number.intervals = 20
wall.type = ChargeOnEB
wall.intervals = 20
