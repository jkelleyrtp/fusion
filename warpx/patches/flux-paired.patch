+    // A number in [0,1) fixed by a cell of the domain, the step, the direction of the flux, the place of a
+    // particle in the cell's list and `which`. Flux sources with `flux_paired` draw where their particles
+    // start from this instead of from the random stream, so that two species make them at the same places.
+    AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+    std::uint64_t pairedMix (std::uint64_t h, std::uint64_t const v) noexcept
+    {
+        h ^= v;
+        h = (h ^ (h >> 30)) * 0xBF58476D1CE4E5B9ULL;
+        h = (h ^ (h >> 27)) * 0x94D049BB133111EBULL;
+        return h ^ (h >> 31);
+    }
+
+    AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+    amrex::Real pairedUniform (amrex::GpuArray<amrex::Real,AMREX_SPACEDIM> const& corner,
+                               amrex::GpuArray<amrex::Real,AMREX_SPACEDIM> const& dx,
+                               amrex::GpuArray<amrex::Real,AMREX_SPACEDIM> const& problo,
+                               amrex::IntVect const& iv, int const step, int const direction,
+                               int const i_part, int const which) noexcept
+    {
+        std::uint64_t h = 0x9E3779B97F4A7C15ULL;
+        for (int d = 0; d < AMREX_SPACEDIM; ++d) {
+            // index of the cell in the whole domain, whichever box or tile it is reached from
+            h = pairedMix(h, static_cast<std::uint64_t>(static_cast<std::int64_t>(
+                std::floor((corner[d] + iv[d]*dx[d] - problo[d])/dx[d] + 0.5_rt))));
+        }
+        h = pairedMix(h, static_cast<std::uint64_t>(step));
+        h = pairedMix(h, static_cast<std::uint64_t>(direction + 1));
+        h = pairedMix(h, static_cast<std::uint64_t>(i_part));
+        h = pairedMix(h, static_cast<std::uint64_t>(which));
+        return static_cast<amrex::Real>(h >> 11) * static_cast<amrex::Real>(1.0/9007199254740992.0);
+    }
