# Mono-energetic electrons drifting through uniform H2 in a periodic box with no fields:
# the ion count must grow at ngas*sigma(E)*v per electron.
max_step = 50
amr.n_cell = 32 32 32
amr.max_grid_size = 32
amr.max_level = 0
geometry.dims = 3
geometry.prob_lo = -0.005 -0.005 -0.005
geometry.prob_hi = 0.005 0.005 0.005
boundary.field_lo = periodic periodic periodic
boundary.field_hi = periodic periodic periodic
algo.maxwell_solver = none
warpx.const_dt = 1.e-12
warpx.random_seed = 3
my_constants.ek = 1000.
my_constants.ngas = 1.e22
my_constants.gam = 1+ek*q_e/(m_e*clight**2)
particles.species_names = electrons ions
electrons.species_type = electron
electrons.injection_style = NRandomPerCell
electrons.num_particles_per_cell = 27
electrons.profile = constant
electrons.density = 1.e6
electrons.momentum_distribution_type = constant
electrons.uz = sqrt(gam*gam-1)
ions.charge = q_e
ions.mass = 2.016*1.66053906660e-27
ions.injection_style = none
collisions.collision_names = gas
gas.type = background_mcc
gas.species = electrons
gas.background_density = ngas
gas.background_temperature = 300.
gas.background_mass = 2.016*1.66053906660e-27
gas.scattering_processes = ionization
gas.ionization_energy = 15.43
gas.ionization_cross_section = h2_ionization.dat
gas.ionization_species = ions
number.type = ParticleNumber
number.intervals = 1
eall.type = ParticleHistogram
eall.intervals = 50
eall.species = electrons
eall.bin_number = 2000
eall.bin_min = 0.
eall.bin_max = 10000.
eall.histogram_function(t,x,y,z,ux,uy,uz) = "m_e*clight**2/q_e*(sqrt(1+ux*ux+uy*uy+uz*uz)-1)"
algo.particle_shape = 1
warpx.reduced_diags_names = number eall energy edir
energy.type = ParticleEnergy
energy.intervals = 50
edir.type = ParticleHistogram
edir.intervals = 50
edir.species = electrons
edir.bin_number = 200
edir.bin_min = -1.
edir.bin_max = 1.0000001
edir.histogram_function(t,x,y,z,ux,uy,uz) = "uz/sqrt(ux*ux+uy*uy+uz*uz)"
